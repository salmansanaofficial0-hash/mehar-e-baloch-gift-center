# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb+srv://your_user:your_password@cluster.mongodb.net/mehar-baloch

# JWT
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your_super_secret_refresh_key_here

# Admin Credentials (auto-seeded on startup)
ADMIN_EMAIL=admin@meharbaloch.com
ADMIN_PASSWORD=Admin@123

# Client URL (for CORS + email links)
CLIENT_URL=http://localhost:5173

# Cloudinary (optional - falls back to local storage)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Email (SMTP) - falls back to console logging in dev
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@email.com
SMTP_PASS=your_app_password

# Stripe (optional - for card payments)
STRIPE_SECRET_KEY=sk_test_your_stripe_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
